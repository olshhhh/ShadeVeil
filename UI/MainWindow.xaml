<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShadeVeil — Control de Iluminacion y Privacidad"
        Width="540"
        Height="720"
        MinWidth="470"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#0B0E14"
        Foreground="#E6EDF3"
        FontFamily="Segoe UI"
        Topmost="True"
        ResizeMode="CanResize">

    <Window.Resources>
        <SolidColorBrush x:Key="BgPrimaryBrush" Color="#0B0E14"/>
        <SolidColorBrush x:Key="BgCardBrush" Color="#131822"/>
        <SolidColorBrush x:Key="BgElevatedBrush" Color="#1A2130"/>
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#263042"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F6FC"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B949E"/>
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentAmberBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="SuccessGreenBrush" Color="#22C55E"/>

        <!-- Modern Toggle Switch Style for CheckBox -->
        <Style x:Key="PowerToggleStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Track"
                                    Width="52"
                                    Height="28"
                                    CornerRadius="14"
                                    Background="#263042"
                                    BorderBrush="#374357"
                                    BorderThickness="1"
                                    Padding="3">
                                <Border x:Name="Knob"
                                        Width="20"
                                        Height="20"
                                        CornerRadius="10"
                                        Background="#9CA3AF"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0284C7"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter TargetName="Knob" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#7DD3FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Dark Action Button -->
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A2130"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#2E3A4E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#232D42"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#141A26"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preset Card Button -->
        <Style x:Key="PresetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#161D29"/>
            <Setter Property="Foreground" Value="#F0F6FC"/>
            <Setter Property="BorderBrush" Value="#263042"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2738"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#121722"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tint Swatch RadioButton -->
        <Style x:Key="TintRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Background" Value="#161D29"/>
            <Setter Property="BorderBrush" Value="#263042"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2738"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4B5D7A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#17253B"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Scope RadioButton -->
        <Style x:Key="ScopeRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#9BA6B5"/>
            <Setter Property="Background" Value="#111620"/>
            <Setter Property="BorderBrush" Value="#263042"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B2332"/>
                                <Setter Property="Foreground" Value="#E6EDF3"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0C4A6E"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#F0F9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Intuitive Ergonomic Opacity Slider -->
        <Style x:Key="OpacitySliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="5"/>
            <Setter Property="Maximum" Value="95"/>
            <Setter Property="SmallChange" Value="1"/>
            <Setter Property="LargeChange" Value="5"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="32">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="10"
                                                        CornerRadius="5,0,0,5"
                                                        Background="#38BDF8"
                                                        VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="10"
                                                        CornerRadius="0,5,5,0"
                                                        Background="#263042"
                                                        VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbCircle"
                                                        Width="22"
                                                        Height="22"
                                                        CornerRadius="11"
                                                        Background="#F8FAFC"
                                                        BorderBrush="#38BDF8"
                                                        BorderThickness="3"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbCircle" Property="Width" Value="24"/>
                                                        <Setter TargetName="ThumbCircle" Property="Height" Value="24"/>
                                                        <Setter TargetName="ThumbCircle" Property="CornerRadius" Value="12"/>
                                                        <Setter TargetName="ThumbCircle" Property="BorderBrush" Value="#7DD3FC"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbCircle" Property="Background" Value="#E0F2FE"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Option CheckBox -->
        <Style x:Key="OptionCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="18,16,18,12">
            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="10" Height="10" CornerRadius="5" Background="#38BDF8" Margin="0,0,8,0"/>
                            <TextBlock Text="ShadeVeil"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       Foreground="#F8FAFC"/>
                            <Border x:Name="StatusBadge"
                                    Margin="10,0,0,0"
                                    Padding="8,2"
                                    CornerRadius="5"
                                    Background="#052E16"
                                    BorderBrush="#16A34A"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="StatusBadgeText"
                                           Text="ACTIVO"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="#4ADE80"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Velo de atenuacion visual para privacidad y comodidad ocular"
                                   FontSize="12"
                                   Foreground="#8B949E"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="PowerLabel"
                                   Text="Velo ON"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#93C5FD"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <CheckBox x:Name="PowerToggle"
                                  Style="{StaticResource PowerToggleStyle}"
                                  IsChecked="True"
                                  ToolTip="Activar o pausar el velo de pantalla (Ctrl+Alt+D)"/>
                    </StackPanel>
                </Grid>

                <!-- Hero Opacity Slider Card -->
                <Border Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="INTENSIDAD DEL VELO (OPACIDAD)"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#7DD3FC"/>
                                <TextBlock Text="Desliza o usa la rueda del mouse para atenuar la pantalla"
                                           FontSize="11.5"
                                           Foreground="#8B949E"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="OpacityPercentText"
                                           Text="45%"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="#F8FAFC"/>
                            </StackPanel>
                        </Grid>

                        <!-- Slider + Stepper Buttons -->
                        <Grid Margin="0,4,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnDecreaseOpacity"
                                    Grid.Column="0"
                                    Content="-5%"
                                    Style="{StaticResource DarkButtonStyle}"
                                    Padding="10,6"
                                    Margin="0,0,10,0"
                                    ToolTip="Reducir opacidad 5%"/>

                            <Slider x:Name="OpacitySlider"
                                    Grid.Column="1"
                                    Style="{StaticResource OpacitySliderStyle}"
                                    Value="45"/>

                            <Button x:Name="BtnIncreaseOpacity"
                                    Grid.Column="2"
                                    Content="+5%"
                                    Style="{StaticResource DarkButtonStyle}"
                                    Padding="10,6"
                                    Margin="10,0,0,0"
                                    ToolTip="Aumentar opacidad 5%"/>
                        </Grid>

                        <!-- Scale Markers -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="5% Sutil" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1" Text="35% Comodo" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="65% Privado" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="95% Maximo" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Quick Presets -->
                <Border Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="MODOS RAPIDOS DE PRIVACIDAD Y CONFORT"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#7DD3FC"
                                   Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button x:Name="BtnPresetReading" Grid.Row="0" Grid.Column="0" Style="{StaticResource PresetButtonStyle}" Tag="reading">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Lectura Nocturna" FontWeight="SemiBold" FontSize="12.5" Foreground="#F0F6FC"/>
                                        <TextBlock Text="35%" FontWeight="Bold" FontSize="12" Foreground="#F59E0B" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="Tono ambar suave para leer" FontSize="11" Foreground="#8B949E" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnPresetPrivacy" Grid.Row="0" Grid.Column="2" Style="{StaticResource PresetButtonStyle}" Tag="privacy">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Privacidad Oficina" FontWeight="SemiBold" FontSize="12.5" Foreground="#F0F6FC"/>
                                        <TextBlock Text="60%" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="Baja visibilidad lateral" FontSize="11" Foreground="#8B949E" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnPresetFocus" Grid.Row="2" Grid.Column="0" Style="{StaticResource PresetButtonStyle}" Tag="focus">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Focus Profundo" FontWeight="SemiBold" FontSize="12.5" Foreground="#F0F6FC"/>
                                        <TextBlock Text="75%" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="Oscurecimiento neutro intenso" FontSize="11" Foreground="#8B949E" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnPresetStealth" Grid.Row="2" Grid.Column="2" Style="{StaticResource PresetButtonStyle}" Tag="stealth">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Velo Maximo" FontWeight="SemiBold" FontSize="12.5" Foreground="#F0F6FC"/>
                                        <TextBlock Text="88%" FontWeight="Bold" FontSize="12" Foreground="#F87171" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="Maxima discrecion inmediata" FontSize="11" Foreground="#8B949E" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Color Tint Selector -->
                <Border Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="TONALIDAD DEL FILTRO"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#7DD3FC"
                                   Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <RadioButton x:Name="RadioTintBlack" Grid.Row="0" Grid.Column="0" GroupName="TintGroup" Style="{StaticResource TintRadioStyle}" Tag="#000000" IsChecked="True">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="14" Height="14" CornerRadius="7" Background="#000000" BorderBrush="#64748B" BorderThickness="1" Margin="0,0,8,0"/>
                                    <TextBlock Text="Negro Puro" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="RadioTintAmber" Grid.Row="0" Grid.Column="2" GroupName="TintGroup" Style="{StaticResource TintRadioStyle}" Tag="#1C0F00">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="14" Height="14" CornerRadius="7" Background="#92400E" BorderBrush="#F59E0B" BorderThickness="1" Margin="0,0,8,0"/>
                                    <TextBlock Text="Ambar Nocturno" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="RadioTintSlate" Grid.Row="2" Grid.Column="0" GroupName="TintGroup" Style="{StaticResource TintRadioStyle}" Tag="#0B111E">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="14" Height="14" CornerRadius="7" Background="#1E3A8A" BorderBrush="#60A5FA" BorderThickness="1" Margin="0,0,8,0"/>
                                    <TextBlock Text="Pizarra Privacidad" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="RadioTintSepia" Grid.Row="2" Grid.Column="2" GroupName="TintGroup" Style="{StaticResource TintRadioStyle}" Tag="#141008">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="14" Height="14" CornerRadius="7" Background="#786238" BorderBrush="#D6B87A" BorderThickness="1" Margin="0,0,8,0"/>
                                    <TextBlock Text="Sepia Suave" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Monitor Scope & System Behavior -->
                <Border Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="PANTALLAS Y COMPORTAMIENTO"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#7DD3FC"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="MonitorCountText"
                                       Text="1 pantalla detectada"
                                       FontSize="11.5"
                                       Foreground="#8B949E"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="RadioScopeAll" Grid.Column="0" Content="Todas" GroupName="ScopeGroup" Style="{StaticResource ScopeRadioStyle}" Tag="AllScreens" IsChecked="True"/>
                            <RadioButton x:Name="RadioScopePrimary" Grid.Column="2" Content="Principal" GroupName="ScopeGroup" Style="{StaticResource ScopeRadioStyle}" Tag="PrimaryOnly"/>
                            <RadioButton x:Name="RadioScopeSecondary" Grid.Column="4" Content="Secundarias" GroupName="ScopeGroup" Style="{StaticResource ScopeRadioStyle}" Tag="SecondaryOnly"/>
                        </Grid>

                        <CheckBox x:Name="ChkEnableHotkeys"
                                  Style="{StaticResource OptionCheckBoxStyle}"
                                  Content="Atajos globales: Ctrl+Alt+D (Pausar) · Ctrl+Alt+Flechas (±5%)"
                                  IsChecked="True"/>

                        <CheckBox x:Name="ChkKeepPanelAbove"
                                  Style="{StaticResource OptionCheckBoxStyle}"
                                  Content="Mantener este panel nitido por encima del velo (Topmost)"
                                  IsChecked="True"/>

                        <CheckBox x:Name="ChkStartMinimized"
                                  Style="{StaticResource OptionCheckBoxStyle}"
                                  Content="Iniciar oculto en la bandeja del sistema"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Bar -->
        <Border Grid.Row="1"
                Background="#0E131B"
                BorderBrush="#222B3A"
                BorderThickness="0,1,0,0"
                Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="FooterHintText"
                           Grid.Column="0"
                           Text="Los clics atraviesan el velo sin interrumpir tu trabajo"
                           FontSize="11.5"
                           Foreground="#8B949E"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnReset"
                            Content="Restablecer"
                            Style="{StaticResource DarkButtonStyle}"
                            Margin="0,0,8,0"
                            ToolTip="Volver a valores predeterminados (45% Negro Puro)"/>
                    <Button x:Name="BtnMinimizeToTray"
                            Content="Ocultar en Bandeja"
                            Style="{StaticResource DarkButtonStyle}"
                            ToolTip="Minimiza el panel a la bandeja manteniendo el velo activo"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
